{
  "name": "kernelarchive",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @kernelarchive/database db:generate",
    "db:migrate": "pnpm --filter @kernelarchive/database db:migrate",
    "system:index": "pnpm --filter @kernelarchive/scripts index-system",
    "api:dev": "pnpm --filter @kernelarchive/api dev",
    "web:dev": "pnpm --filter @kernelarchive/web dev",
    "worker:dev": "pnpm --filter @kernelarchive/diff-worker dev",
    "openapi:generate": "pnpm --filter @kernelarchive/scripts openapi:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
