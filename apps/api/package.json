{
  "name": "@kernelarchive/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backfill-types": "tsx --max-old-space-size=8192 src/backfill-types.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "create-admin": "tsx src/create-admin.ts",
    "dev": "tsx watch --max-old-space-size=8192 src/index.ts",
    "lint": "eslint .",
    "start": "tsx --max-old-space-size=8192 src/index.ts",
    "test": "tsx --test test/archive-store.test.ts test/archive-importer.test.ts test/app.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@kernelarchive/shared": "workspace:*",
    "fastify": "^5.2.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
