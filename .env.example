# KernelArchive configuration. Copy to .env and adjust.
# Every value here is a default that already works for local development, so an
# empty .env is valid; override only what you need.

# --- Network -----------------------------------------------------------------
# Keep HOST on loopback and put a TLS-terminating reverse proxy in front of it.
HOST=127.0.0.1
PORT=4002

# Optional behind a reverse proxy. Requests whose Origin matches the Host they were
# addressed to are treated as same-origin and accepted automatically, so the app does
# not need to be told its own public URL. Set this only to mark the session cookie
# Secure (use your https origin), or to allow an origin that differs from the host,
# such as a frontend on another domain.
PUBLIC_APP_URL=http://localhost:3000
TRUSTED_ORIGINS=

# Which upstream addresses may set X-Forwarded-For. Set this to your reverse proxy
# ONLY. Trusting an address that can be spoofed lets anyone reset their rate limit.
TRUST_PROXY=127.0.0.1,::1

# Where the web app reaches the API. Server-side rewrites use the internal URL.
KERNELARCHIVE_API_INTERNAL_URL=http://127.0.0.1:4002
NEXT_PUBLIC_API_BASE_URL=http://localhost:4002

# --- Web app metadata --------------------------------------------------------
# Used for canonical URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SOURCE_URL=
# Optional. Each stays hidden in the UI while empty.
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_DONATE_BTC=

# --- Storage -----------------------------------------------------------------
KERNELARCHIVE_LOCAL_CACHE_DIR=local-cache
KERNELARCHIVE_DATA_DB_PATH=local-cache/archive.sqlite
KERNELARCHIVE_AUTH_DB_PATH=local-cache/auth.sqlite

# Directory of Windows binaries the importer scans. A production mirror serving a
# prebuilt database does not need this; downloads fall back to the binary cache.
KERNELARCHIVE_ARCHIVE_DIR=Archive
KERNELARCHIVE_ARCHIVE_IMPORT_CONCURRENCY=4
KERNELARCHIVE_ARCHIVE_SCAN_INTERVAL_MS=300000

# SET THIS TO false ON A SERVER SERVING A PREBUILT ARCHIVE.
# The importer treats a file as unchanged based on its size, mtime and ctime.
# Copying or extracting Archive/ resets those, so every file looks new and the whole
# archive is re-indexed. Without the symbol cache present that replaces PDB-derived
# types and functions with PE exports alone, destroying the data you shipped.
# Downloads do not depend on this; they resolve without the importer.
KERNELARCHIVE_ARCHIVE_IMPORT_ENABLED=true

# --- Symbols (indexing only, Windows host) -----------------------------------
KERNELARCHIVE_SYMBOL_SERVER_URLS=https://msdl.microsoft.com/download/symbols
KERNELARCHIVE_PDB_DUMP_PATH=tools/pdb-dump/pdb_dump.exe
# Ships with Visual Studio. Adjust for Community or BuildTools installs.
KERNELARCHIVE_DIA_DLL_PATH=C:\Program Files\Microsoft Visual Studio\2022\Enterprise\DIA SDK\bin\amd64\msdia140.dll
PDB_DOWNLOAD_TIMEOUT_MS=60000
PDB_FAILURE_CACHE_MINUTES=15

# --- Limits ------------------------------------------------------------------
RATE_LIMIT_PUBLIC_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=1200
# Optional shared secret. While empty, nothing can reach the elevated rate tier.
KERNELARCHIVE_API_KEY=

# Applies to JSON bodies, including anonymous POST routes.
JSON_BODY_MAX_BYTES=1048576
# Applies to admin binary uploads only.
UPLOAD_MAX_BYTES=268435456

# --- Sessions ----------------------------------------------------------------
AUTH_SESSION_HOURS=12
AUTH_IDLE_MINUTES=60
AUTH_MAX_FAILURES=5
AUTH_LOCK_MINUTES=15
